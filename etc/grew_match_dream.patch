+(* ============================================================================================================================ *)
+(* relative url metas (starting with "/") get the LTDB base URL from the
+   environment, so corpora need not be re-exported when the address changes *)
+let ltdb_base_url = CCOption.get_or ~default:"" (Sys.getenv_opt "LTDB_BASE_URL")
+
+let expand_url s =
+  if String.length s > 0 && s.[0] = '/'
+  then ltdb_base_url ^ s
+  else s
+
